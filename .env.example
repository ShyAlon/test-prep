# Optional overrides. The checked-in public Firebase web config works by default.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional override for the public, restricted Drive-only browser key.
VITE_GOOGLE_DRIVE_API_KEY=

# Development only: route authentication to a local emulator.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Optional local Firestore emulator for testing behavior tracking.
# VITE_FIREBASE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080
